# Instagram Professional Account (Business oder Creator) mit einer Meta-App verbinden.
# Den Langzeit-Access-Token niemals im Browser oder in Git ablegen.
INSTAGRAM_USER_ID=YOUR_INSTAGRAM_USER_ID
INSTAGRAM_ACCESS_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN
PORT=3000
# In Produktion als persistentes Docker-Volume oder Webspace-Verzeichnis einbinden.
MEDIA_CACHE_DIR=storage/instagram